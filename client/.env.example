# ─────────────────────────────────────────────────────────────────────
# Variables de entorno del frontend (Vite).
# Copia este archivo a `.env` y rellena los valores reales.
#
#   cp .env.example .env
#
# Obtén el Client ID en:
#   Google Cloud Console → APIs & Servicios → Credenciales → OAuth 2.0
#   Crea un cliente "Aplicación web" y copia el Client ID
# ─────────────────────────────────────────────────────────────────────

VITE_GOOGLE_CLIENT_ID=123456789-xxxxxxxxxxxx.apps.googleusercontent.com

# URLs del backend (opcional — por defecto apunta a localhost)
# VITE_USERS_BASE=http://localhost:3100/api/users
# VITE_ATTEMPTS_BASE=http://localhost:3102/api/attempts
